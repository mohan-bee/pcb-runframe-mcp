{
  "name": "pcb-runframe-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An MCP App that renders interactive PCB designs directly in ChatGPT.",
  "scripts": {
    "build": "npm run build:widget && tsc",
    "build:widget": "node scripts/build-widget.mjs",
    "check": "tsc --noEmit",
    "dev": "tsx watch server/index.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
